{
  "name": "occam-nominal",
  "author": "James Smith",
  "version": "1.0.460",
  "license": "MIT, Anti-996",
  "homepage": "https://github.com/djalbat/occam-nominal",
  "description": "Occam's Nominal language.",
  "repository": {
    "type": "git",
    "url": "https://github.com/djalbat/occam-nominal"
  },
  "dependencies": {
    "necessary": "^17.6.3",
    "occam-furtle": "^3.0.458",
    "occam-grammar-utilities": "^8.1.22",
    "occam-languages": "^3.0.16",
    "occam-query": "^4.1.206"
  },
  "devDependencies": {
    "@swc/core": "1.13.20",
    "decaf-cli": "^1.0.37",
    "easy": "^25.0.8",
    "easy-layout": "^6.0.336",
    "easy-with-style": "^3.0.577",
    "esbuild": "0.11.14",
    "express": "^4.17.1",
    "juxtapose": "^4.0.143",
    "lively-cli": "^3.0.3",
    "occam-lexers": "^23.2.10",
    "occam-model": "^1.0.578",
    "occam-parsers": "^23.2.13",
    "occam-server": "^7.0.78",
    "watchful-cli": "^1.7.102"
  },
  "scripts": {
    "start": "node ./bin/main.js",
    "clean": "rm -rf ./lib",
    "watchful": "watchful -m --transpiler=swc --bundler=esbuild --source-directory=./src --lib-directory=./lib --entry-file=example.js --bundle-file=./example.js --wait=100",
    "batch": "npm run watchful batch --",
    "batch-debug": "npm run watchful batch -- --debug",
    "incremental": "npm run watchful incremental --",
    "incremental-debug": "npm run watchful incremental -- --debug",
    "build": "npm run clean && npm run batch",
    "build-debug": "npm run clean && npm run batch-debug",
    "watch": "npm run clean && npm run batch && npm run incremental",
    "watch-debug": "npm run clean && npm run batch-debug && npm run incremental-debug",
    "test": "decaf test -f"
  },
  "files": [
    "src",
    "lib"
  ],
  "main": "./lib/index.js"
}
